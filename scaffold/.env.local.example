# Robinhood Chain Testnet — copy to .env.local and fill in
NEXT_PUBLIC_TESTNET=true
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# WalletConnect
NEXT_PUBLIC_WC_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# Filled in AFTER you run DeployAll (do NOT hardcode before deployment)
NEXT_PUBLIC_PROJECT_REGISTRY=
NEXT_PUBLIC_ORG_REGISTRY=
NEXT_PUBLIC_PARTNERSHIP_REGISTRY=
NEXT_PUBLIC_GRANT_REGISTRY=
NEXT_PUBLIC_INVESTOR_REGISTRY=
NEXT_PUBLIC_REPUTATION_REGISTRY=
