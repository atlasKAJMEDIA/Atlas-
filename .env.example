# Copy to .env.local for local dev, and set the same keys in
# Vercel → Project Settings → Environment Variables for deployment.

# --- AI backend (server-side only, never exposed to the browser) ---
#
# FREE DEMO MODE: leave VIRTUALS_API_KEY blank (or set HELIX_DEMO_MODE=1) and the
# app generates realistic, project-specific content locally — zero API calls, zero
# cost, every feature works. This is the recommended setting for demonstrations.
#
# HELIX_DEMO_MODE=1

# Virtuals compute gateway key (acp-...). This is NOT an Anthropic key — Virtuals
# fronts Claude models through an OpenAI-compatible /chat/completions endpoint.
# When set (and HELIX_DEMO_MODE is off), the app calls the real model, and still
# falls back to demo content automatically if the gateway is unreachable.
VIRTUALS_API_KEY=

# Optional overrides (defaults shown)
# VIRTUALS_BASE_URL=https://compute.virtuals.io/v1
# VIRTUALS_MODEL=claude-opus-4-7-fast

# --- Optional: only needed once you wire up real WalletConnect / on-chain calls ---
# from https://cloud.reown.com (formerly WalletConnect Cloud)
# NEXT_PUBLIC_WC_PROJECT_ID=

# --- Optional: filled in AFTER deploying scaffold/contracts (see scaffold/README.md) ---
# Setting these switches on-chain writes from simulated to real. No code change needed.
# NEXT_PUBLIC_PROJECT_REGISTRY=
# NEXT_PUBLIC_ORG_REGISTRY=
# NEXT_PUBLIC_PARTNERSHIP_REGISTRY=
# NEXT_PUBLIC_GRANT_REGISTRY=
# NEXT_PUBLIC_INVESTOR_REGISTRY=
# NEXT_PUBLIC_REPUTATION_REGISTRY=
# NEXT_PUBLIC_PROPOSAL_REGISTRY=
# NEXT_PUBLIC_IDENTITY_REGISTRY=
# NEXT_PUBLIC_NOTIFICATION_REGISTRY=
# NEXT_PUBLIC_ACTIVITY_REGISTRY=

# --- Optional: live opportunity scanning ---
# With one of these, /api/scan runs a REAL web search and returns openings marked
# confidence:"verified" with source URLs. Without one, results are clearly marked
# confidence:"inferred" and the app tells the user to confirm them.
# SERPER_API_KEY=              # from serper.dev
# TAVILY_API_KEY=              # from tavily.com

# --- Optional: outreach sending. Each channel activates when its vars exist. ---
# Without these the app drafts messages and tells you exactly what's missing.
# RESEND_API_KEY=              # + OUTREACH_FROM_EMAIL  -> Email
# OUTREACH_FROM_EMAIL=
# TELEGRAM_BOT_TOKEN=          # + TELEGRAM_CHAT_ID     -> Telegram
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=         #                        -> Discord
# NEYNAR_API_KEY=              # + NEYNAR_SIGNER_UUID   -> Farcaster
# NEYNAR_SIGNER_UUID=
# X and LinkedIn require per-user OAuth, not a static key.
