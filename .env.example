# Copy to .env.local for local dev, and set the same keys in
# Vercel → Project Settings → Environment Variables for deployment.

# --- Required: server-side only, powers the AI features (never exposed to the browser) ---
# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the model used by app/api/claude/route.js
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Optional: only needed once you wire up real WalletConnect / on-chain calls ---
# from https://cloud.reown.com (formerly WalletConnect Cloud)
# NEXT_PUBLIC_WC_PROJECT_ID=

# --- Optional: filled in AFTER deploying scaffold/contracts (see scaffold/README.md) ---
# NEXT_PUBLIC_PROJECT_REGISTRY=
# NEXT_PUBLIC_ORG_REGISTRY=
# NEXT_PUBLIC_PARTNERSHIP_REGISTRY=
# NEXT_PUBLIC_GRANT_REGISTRY=
# NEXT_PUBLIC_INVESTOR_REGISTRY=
# NEXT_PUBLIC_REPUTATION_REGISTRY=
